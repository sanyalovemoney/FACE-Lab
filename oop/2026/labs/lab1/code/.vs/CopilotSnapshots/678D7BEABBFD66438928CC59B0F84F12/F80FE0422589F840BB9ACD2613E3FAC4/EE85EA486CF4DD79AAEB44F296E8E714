#include "resource.h"
#include "module1.h"
#include "module2.h"

// Global variable to hold the text for painting
WCHAR szDisplayText[256] = L"Будь ласка, оберіть роботу в меню";
BOOL bNeedsRepaint = FALSE;

LRESULT CALLBACK WndProc(HWND hWnd, UINT message, WPARAM wParam, LPARAM lParam)
{
    switch (message)
    {
    case WM_COMMAND:
        {
            int wmId = LOWORD(wParam);
            switch (wmId)
            {
            case IDM_WORK1:
                if (Func_MOD1(hWnd))
                {
                    wcscpy_s(szDisplayText, 256, szResult_MOD1);
                    bNeedsRepaint = TRUE;
                    InvalidateRect(hWnd, NULL, TRUE);
                }
                break;
            case IDM_WORK2:
                if (Func_MOD2(hWnd))
                {
                    wcscpy_s(szDisplayText, 256, szResult_MOD2);
                    bNeedsRepaint = TRUE;
                    InvalidateRect(hWnd, NULL, TRUE);
                }
                break;
            case IDM_EXIT:
                DestroyWindow(hWnd);
                break;
            case IDM_ABOUT:
                MessageBox(hWnd, L"Лабораторна робота №1\nСтудент: Мащута Олександр", L"Про програму", MB_OK);
                break;
            default:
                return DefWindowProc(hWnd, message, wParam, lParam);
            }
        }
        break;

    case WM_PAINT:
        {
            PAINTSTRUCT ps;
            HDC hdc = BeginPaint(hWnd, &ps);

            RECT rect;
            GetClientRect(hWnd, &rect);

            // Center the text
            SIZE size;
            GetTextExtentPoint32(hdc, szDisplayText, wcslen(szDisplayText), &size);
            int x = (rect.right - size.cx) / 2;
            int y = (rect.bottom - size.cy) / 2;

            TextOut(hdc, x, y, szDisplayText, (int)wcslen(szDisplayText));

            EndPaint(hWnd, &ps);
        }
        break;

    case WM_DESTROY:
        PostQuitMessage(0);
        break;

    default:
        return DefWindowProc(hWnd, message, wParam, lParam);
    }
    return 0;
}

ATOM MyRegisterClass(HINSTANCE hInstance)
{
    WNDCLASSEXW wcex;
    ZeroMemory(&wcex, sizeof(WNDCLASSEX));

    wcex.cbSize = sizeof(WNDCLASSEX);
    wcex.style = CS_HREDRAW | CS_VREDRAW;
    wcex.lpfnWndProc = WndProc;
    wcex.hInstance = hInstance;
    wcex.hCursor = LoadCursor(NULL, IDC_ARROW);
    wcex.hbrBackground = (HBRUSH)(COLOR_WINDOW + 1);
    wcex.lpszClassName = IDC_LAB1_MAIN;
    wcex.hIcon = LoadIcon(NULL, IDI_APPLICATION);

    return RegisterClassExW(&wcex);
}

BOOL InitInstance(HINSTANCE hInstance, int nCmdShow)
{
    HWND hWnd = CreateWindowW(IDC_LAB1_MAIN, L"Лабораторна робота №1", WS_OVERLAPPEDWINDOW,
        CW_USEDEFAULT, 0, 600, 400, nullptr, nullptr, hInstance, nullptr);

    if (!hWnd)
        return FALSE;

    ShowWindow(hWnd, nCmdShow);
    UpdateWindow(hWnd);

    // Attach menu
    HMENU hMenu = LoadMenu(hInstance, MAKEINTRESOURCE(IDC_LAB1_MAIN)); // In this case, the menu has the same ID as class
    // Actually, in Lab1.rc the menu is called IDC_LAB1_MAIN
    SetMenu(hWnd, hMenu);

    return TRUE;
}

int APIENTRY wWinMain(_In_ HINSTANCE hInstance,
                     _In_opt_ HINSTANCE hPrevInstance,
                     _In_ LPWSTR    lpCmdLine,
                     _In_ int       nCmdShow)
{
    UNREFERENCED_PARAMETER(hPrevInstance);
    UNREFERENCED_PARAMETER(lpCmdLine);

    if (!MyRegisterClass(hInstance))
        return 0;

    if (!InitInstance(hInstance, nCmdShow))
        return 0;

    MSG msg;
    while (GetMessage(&msg, nullptr, 0, 0))
    {
        TranslateMessage(&msg);
        DispatchMessage(&msg);
    }

    return (int)msg.wParam;
}

